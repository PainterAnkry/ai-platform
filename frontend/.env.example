# Frontend build-time configuration. Vite reads variables prefixed with VITE_.
# Copy to `.env.local` for local dev overrides; do NOT commit secrets.

# Where the FastAPI backend lives. In Docker compose, ``backend`` resolves
# to the backend container; locally, use http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# App display name
VITE_APP_NAME=AI Platform
VITE_APP_VERSION=0.1.0