# Backend-specific overrides (compose passes these into the container).
# All values are provided by the top-level .env at runtime.

APP_ENV=development
LOG_LEVEL=INFO

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=aiplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional DSN override; blank = build the PostgreSQL DSN from POSTGRES_* above.
# SQLite is a zero-install preview mode (parsing then runs inline):
#   DATABASE_URL=sqlite:///./ai_platform.db
DATABASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery (Phase 2 async ingestion). Blank = derived from REDIS_*
# (broker db 1, result backend db 2).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# true = parse inside the API process; no worker and no Redis required.
CELERY_TASK_ALWAYS_EAGER=false

# Uploads (Phase 2 documents)
UPLOAD_DIR=./uploads
# 25 MB
MAX_UPLOAD_SIZE_BYTES=26214400

# AI providers (Phase 3-5). Defaults are offline (mock LLM / deterministic
# embeddings) so the stack runs with no API key. To use the real local model
# served by model-service with Qwen3.5-0.8B:
#   LLM_PROVIDER=openai
#   LLM_API_BASE=http://127.0.0.1:9000/v1
#   LLM_API_KEY=local
#   LLM_MODEL=qwen3.5-0.8b
#   LLM_TEMPERATURE=0.7        # measured: keeps the 0.8B model on the rails
#   LLM_MAX_OUTPUT_TOKENS=256  # CPU inference is slow (~5 tok/s)
#   LLM_TIMEOUT_SECONDS=300
# Embeddings/reranker can point at the same service (deterministic
# implementations) or at a real vendor; see the top-level .env.example.
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=lexical

# Security
SECRET_KEY=please_change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost

# Project
PROJECT_NAME=ai-platform