# =====================================================================
# AI 智能知识库与 Agent 工作流平台 — Top-level environment variables
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# =====================================================================

# ---------- Compose / Project ----------
PROJECT_NAME=ai-platform
COMPOSE_PROJECT_NAME=ai-platform

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Frontend ----------
FRONTEND_PORT=5173

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=aiplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional full DSN override. Leave blank to build the PostgreSQL DSN from the
# POSTGRES_* values above. Point it at SQLite for a zero-install local preview
# (no PostgreSQL/Redis needed — parsing then runs inline in the API process):
#   DATABASE_URL=sqlite:///./ai_platform.db
DATABASE_URL=

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Leave blank for no password (dev). Set to a real value in production.
REDIS_PASSWORD=

# ---------- Celery (Phase 2 async ingestion) ----------
# Blank = derive from REDIS_* above (broker db 1, result backend db 2).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# true = run parsing inside the API process (no worker required, no Redis).
CELERY_TASK_ALWAYS_EAGER=false

# ---------- Uploads (Phase 2 documents) ----------
# Path inside the container; the `uploads_data` volume is mounted there for
# both the backend and the worker.
UPLOAD_DIR=/app/uploads
# 25 MB
MAX_UPLOAD_SIZE_BYTES=26214400

# ---------- Phase 3: Embedding ----------
# mock   = deterministic offline embedding (no network, demo/tests default)
# openai = any OpenAI-compatible /v1/embeddings endpoint
# local  = sentence-transformers (requires `pip install sentence-transformers`)
EMBEDDING_PROVIDER=mock
# Vector width. Migration 0003 freezes the pgvector column at this dimension —
# change it only together with a new migration. Must match the chosen model.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
# Required when EMBEDDING_PROVIDER=openai, e.g.:
#   EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
#   EMBEDDING_MODEL=BAAI/bge-m3            (dim 1024)
#   EMBEDDING_API_BASE=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small (dim 1536 -> set EMBEDDING_DIM=1536)
# Local preset — route the whole AI chain through the self-hosted model-service
# container (no external key needed; Phase 7):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_API_BASE=http://model-service:9000/v1
#   EMBEDDING_MODEL=model-service-embedding
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- Phase 3: Reranker ----------
# none    = keep the vector-search order
# lexical = built-in n-gram overlap reranker (offline default)
# api     = Jina/Cohere-style POST {base}/rerank endpoint
RERANKER_PROVIDER=lexical
# Local preset: RERANKER_PROVIDER=api + RERANKER_API_BASE=http://model-service:9000/v1
RERANKER_API_BASE=
RERANKER_API_KEY=
RERANKER_MODEL=

# ---------- Phase 3: LLM (sync; Phase 4 adds SSE streaming) ----------
# mock   = extractive offline answer over retrieved chunks (labelled as mock)
# openai = any OpenAI-compatible /v1/chat/completions endpoint
#
# Three ready-made presets — uncomment ONE group:
#
# (a) Offline stub model-service (default Docker stack, no downloads):
#       LLM_PROVIDER=openai
#       LLM_API_BASE=http://model-service:9000/v1
#       LLM_API_KEY=local
#       LLM_MODEL=model-service-chat
#
# (b) Real local model in the model service on this machine (Qwen3.5-0.8B,
#     see README "本机真实模型"; the service runs the chat endpoint on real
#     weights). temperature 0.7 + top_k 20 on the service side is the measured
#     setting that keeps the 0.8B model from emitting citation-only answers,
#     and CPU inference is slow, hence the small token cap and long timeout.
#       LLM_PROVIDER=openai
#       LLM_API_BASE=http://127.0.0.1:9000/v1
#       LLM_API_KEY=local
#       LLM_MODEL=qwen3.5-0.8b
#       LLM_TEMPERATURE=0.7
#       LLM_MAX_OUTPUT_TOKENS=256
#       LLM_TIMEOUT_SECONDS=300
#
# (c) The same, but the platform runs in Docker and the model service on the
#     host — use host.docker.internal instead of 127.0.0.1:
#       LLM_API_BASE=http://host.docker.internal:9000/v1
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ---------- Phase 3: RAG pipeline ----------
RAG_VECTOR_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# ---------- Phase 6: MCP ----------
# The self-hosted MCP server is mounted on the backend at /api/mcp; the
# agent discovers its tools over loopback HTTP. Blank URL = loopback default.
MCP_ENABLED=true
MCP_SERVER_URL=

# ---------- Security ----------
# 32+ random chars; rotate for production. Used to sign JWT tokens.
SECRET_KEY=please_change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# Comma-separated list. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO